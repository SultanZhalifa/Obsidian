# Postgres
DATABASE_URL=postgres://obsidian:obsidian@localhost:5432/obsidian

# Market gateway
GATEWAY_PORT=8080
GATEWAY_WS_PATH=/stream
# Comma-separated Binance symbols to stream (lowercase, no slash)
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt
# Kline timeframes to subscribe/persist
TIMEFRAMES=1m,5m,15m,1h,4h,1d

# Web
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8080/stream
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Binance public endpoints (no key required).
# Defaults use Binance's official public market-data mirror (data.binance.vision),
# which is reachable worldwide and serves real data. Switch to api.binance.com
# / stream.binance.com:9443 if that host is reachable from your region.
BINANCE_REST_BASE=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision
