{
  "name": "obsidian",
  "version": "0.1.0",
  "private": true,
  "description": "OBSIDIAN — enterprise-grade real-time crypto trading terminal",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace services/market-gateway",
    "dev:web": "npm run dev --workspace apps/web",
    "db:generate": "npm run generate --workspace packages/db",
    "db:migrate": "npm run migrate --workspace packages/db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "next": {
      "postcss": "^8.5.23"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
